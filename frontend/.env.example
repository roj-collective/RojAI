# ── RojAI Frontend — Environment Variables ──────────────────────────────────
#
# Copy this file to .env.local and adjust values for your environment.
# .env.local is git-ignored and must never be committed.

# API base URL (no trailing slash, no path).
# Local development: http://localhost:8000
# AWS deployment:    https://your-api-id.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com

# Cognito User Pool (from CDK output after deployment)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-client-id-here
VITE_COGNITO_REGION=us-east-1
