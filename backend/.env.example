# ── RojAI Backend — Environment Variables ───────────────────────────────────
#
# Copy this file to .env and adjust values for your environment.
# Never commit a .env file with real credentials.

# ── Required ─────────────────────────────────────────────────────────────────

# Set to "true" for local development (no AWS credentials needed).
# Set to "false" to call Amazon Bedrock (requires valid AWS credentials).
USE_MOCK_BEDROCK=true

# ── Real Bedrock mode (USE_MOCK_BEDROCK=false) ────────────────────────────────

# Bedrock model ID. Default: anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# AWS region for Bedrock Runtime. Default: us-east-1
AWS_REGION=us-east-1

# ── CORS ─────────────────────────────────────────────────────────────────────

# Origin allowed to call the API. Default: http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
