# ── RojAI Shopify App — Environment Variables ────────────────────────────────
#
# Copy this file to .env and adjust values for your environment.
# .env files are git-ignored and must NEVER be committed.
#
# To start local PostgreSQL: docker compose up -d
# To apply migrations:       npx prisma migrate deploy

# ── Database (required) ──────────────────────────────────────────────────────
# Local development PostgreSQL (from docker-compose.yml):
DATABASE_URL="postgresql://rojai:rojai_dev@localhost:5432/rojai_dev"

# ── Shopify (injected automatically by `shopify app dev`) ────────────────────
# These are set by the Shopify CLI during development.
# For production, set them in your hosting provider's environment variables.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=read_products
# SHOPIFY_APP_URL=

# ── RojAI Backend API ────────────────────────────────────────────────────────
# The API Gateway base URL for the listing generation Lambda.
# Get this from CDK output after deploying RojAIStack.
# Example: https://abc123.execute-api.us-east-1.amazonaws.com
ROJAI_API_URL=

# API key for authenticating with the backend Lambda.
# Generate with: openssl rand -hex 32
# Must match the ROJAI_API_KEY set in the Lambda environment.
# Leave empty for local development without authentication.
ROJAI_API_KEY=
